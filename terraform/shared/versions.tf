# ---------------------------------------------------------------------------
# Shared provider / version constraints — sourced by each environment via
# a symlink or copy.  Pin all providers to exact minor versions so that
# `terraform init` is fully reproducible across CI and developer machines.
# ---------------------------------------------------------------------------

terraform {
  required_version = ">= 1.7.0"

  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 5.50"
    }
    random = {
      source  = "hashicorp/random"
      version = "~> 3.6"
    }
    archive = {
      source  = "hashicorp/archive"
      version = "~> 2.4"
    }
  }
}
